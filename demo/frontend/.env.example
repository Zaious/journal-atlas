VITE_API_BASE=http://localhost:8000

# Optional support / tip link shown in the page footer. Leave BLANK and the
# link does not render at all — a donation link is the one thing on a public
# page that must never be a plausible-looking guess. Works with any provider
# (Buy Me a Coffee, Ko-fi, GitHub Sponsors); set the label to match.
VITE_SUPPORT_URL=
VITE_SUPPORT_LABEL=Buy me a coffee

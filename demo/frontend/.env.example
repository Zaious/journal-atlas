VITE_API_BASE=http://localhost:8000

# Optional support / tip link shown in the page footer. Leave BLANK and the
# link does not render at all — a donation link is the one thing on a public
# page that must never be a plausible-looking guess.
#
# Buy Me a Coffee is the chosen platform because visitors can pay by card
# without registering. That matters here: the corpus is 88% psychology,
# philosophy, HCI and cognitive science, and GitHub Sponsors — which requires
# the *sponsor* to hold a GitHub account — would be a dead link for most of the
# people this page is for. GitHub Sponsors belongs on the repo instead, where
# the audience is on GitHub by definition.
#
#     VITE_SUPPORT_URL=https://buymeacoffee.com/YOUR-HANDLE
VITE_SUPPORT_URL=
VITE_SUPPORT_LABEL=Buy me a coffee

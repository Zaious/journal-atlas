# Copy this file to `.env` (NOT .env.local — python-dotenv's load_dotenv()
# looks for `.env`; `.env.local` is the Vite convention and applies to the
# frontend only). Both are already gitignored.
#
#     cp .env.example .env
#
# ---------------------------------------------------------------------------
# 1. Which LLM backend runs the extract + synthesize stages
# ---------------------------------------------------------------------------
# "gemini" (default) or "anthropic". Only the selected provider's key is
# required; the other can stay blank.
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# 2. API key — fill in the one matching LLM_PROVIDER above
# ---------------------------------------------------------------------------

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude Console key: https://platform.claude.com
# Must be a Console/pay-as-you-go key, NOT a personal Claude.ai Pro/Max login.
# Anthropic's terms prohibit routing other users' requests through a personal
# subscription; a Console key billed under Commercial Terms is the supported
# way to serve multiple end users from one backend.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# 3. Model IDs (optional — leave blank to use the defaults)
# ---------------------------------------------------------------------------
# Defaults: gemini    -> gemini-3.5-flash-lite for both stages
#           anthropic -> claude-haiku-4-5 (extract) / claude-sonnet-5 (synth)
#
# These are overridable because the exact ID strings for recent releases
# should be confirmed against the provider's own model list rather than
# trusted from a changelog. If a request fails with "model not found", that
# is the first thing to check.
#
# The two stages have very different jobs and can use different models:
#   EXTRACTION — constrained, schema-conforming parsing. Cheap is correct.
#   SYNTHESIS  — must follow CONSUMPTION_CONTRACT.md's honesty rules (cite
#                per-row evidence, flag tiers, never fill a *(pending)*).
#                Overclaiming is the failure mode this whole project guards
#                against, so check real output before settling on the
#                cheapest option here.
EXTRACTION_MODEL=
SYNTHESIS_MODEL=

# ---------------------------------------------------------------------------
# 4. CORS
# ---------------------------------------------------------------------------
# Comma-separated frontend origins. Default covers 5173/5174/5175 — Vite
# auto-increments when a port is taken, so confirm the real one from its
# startup log. A mismatch fails with no symptom other than a CORS error.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

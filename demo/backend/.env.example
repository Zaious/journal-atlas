# Copy this file to .env and fill in a real Claude Console API key.
# Must be a Console/pay-as-you-go API key (platform.claude.com) — NOT your
# personal Claude.ai Pro/Max login. Anthropic's terms explicitly prohibit
# routing other users' requests through a personal subscription; a proper
# API key billed under Commercial Terms is the only permitted way to serve
# multiple end users (free trial or paid) from one backend.
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173
